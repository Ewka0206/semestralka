{
  "info": {
    "name": "SailConnect API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Kompletní kolekce pro SailConnect REST API (http://localhost:8080).\n\nDoporučené pořadí spouštění:\n1. Auth / Registrace\n2. Auth / Přihlášení  ← uloží token do proměnné\n3. Plavby / Vytvoření plavby  ← uloží tripId\n4. Rezervace / Vytvoření rezervace  ← uloží bookingId\n5. Zbytek libovolně"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080/api" },
    { "key": "token",      "value": "" },
    { "key": "userId",     "value": "" },
    { "key": "tripId",     "value": "" },
    { "key": "bookingId",  "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('Registrace vrátila 201 (nebo 409 při opakovaném spuštění)', () => {",
                  "    pm.expect([201, 409]).to.include(code);",
                  "});",
                  "if (code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Testovací Kapitán\",\n  \"email\": \"kapitan@sailconnect.cz\",\n  \"password\": \"heslo123\",\n  \"role\": \"captain\"\n}"
            }
          }
        },
        {
          "name": "Přihlášení",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login vrátil 200 s tokenem a id', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string');",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.collectionVariables.set('token',  body.token);",
                  "    pm.collectionVariables.set('userId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kapitan@sailconnect.cz\",\n  \"password\": \"heslo123\"\n}"
            }
          }
        },
        {
          "name": "Přihlášení – špatné heslo (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Špatné heslo vrátí 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kapitan@sailconnect.cz\",\n  \"password\": \"spatneHeslo\"\n}"
            }
          }
        },
        {
          "name": "Registrace – chybějící pole (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Prázdné tělo vrátí 400 s mapou chyb', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errors).to.be.an('object');",
                  "    pm.expect(Object.keys(body.errors).length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Registrace – neplatný e-mail (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Neplatný formát e-mailu vrátí 400', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errors).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"neniEmail\",\n  \"password\": \"heslo123\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Uživatelé",
      "item": [
        {
          "name": "Detail uživatele",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí detail uživatele', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.equal(pm.collectionVariables.get('userId'));",
                  "    pm.expect(body).to.have.property('email');",
                  "    pm.expect(body).to.have.property('role');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Úprava uživatele",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Úprava vrátí 200 s aktualizovanými daty', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.name).to.equal('Upravený Kapitán');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Upravený Kapitán\",\n  \"email\": \"kapitan@sailconnect.cz\"\n}"
            }
          }
        },
        {
          "name": "Detail uživatele – nenalezen (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Neexistující uživatel vrátí 404', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/neexistujici-id"
          }
        }
      ]
    },

    {
      "name": "Číselníky",
      "item": [
        {
          "name": "Typy plaveb",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí neprázdný seznam typů s code a label', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').and.not.empty;",
                  "    pm.expect(body[0]).to.have.property('code');",
                  "    pm.expect(body[0]).to.have.property('label');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trip-types"
          }
        },
        {
          "name": "Státy (číselník zemí)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí 190 zemí s code a name', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    pm.expect(body.length).to.be.at.least(100);",
                  "    pm.expect(body[0]).to.have.property('code');",
                  "    pm.expect(body[0]).to.have.property('name');",
                  "    const cz = body.find(c => c.code === 'CZ');",
                  "    pm.expect(cz.name).to.equal('Česká republika');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/countries"
          }
        }
      ]
    },

    {
      "name": "Plavby",
      "item": [
        {
          "name": "Seznam všech plaveb",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí pole plaveb', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Vyhledávání plaveb (search + stránkování)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí stránkovaný výsledek s metadaty', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('content');",
                  "    pm.expect(body).to.have.property('totalElements');",
                  "    pm.expect(body).to.have.property('totalPages');",
                  "    pm.expect(body.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/trips/search?q=Korfu&page=0&size=5",
              "query": [
                { "key": "q",    "value": "Korfu" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Seznam plaveb podle vlastníka",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí pole (může být prázdné)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips?owner={{userId}}"
          }
        },
        {
          "name": "Vytvoření plavby",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('tripId', body.id);",
                  "    pm.test('Vytvoření vrátilo 201 a id', () => {",
                  "        pm.expect(body.id).to.be.a('string');",
                  "        pm.expect(body.title).to.exist;",
                  "    });",
                  "} else {",
                  "    pm.test('Neočekávaný status: ' + pm.response.code, () => { pm.expect(pm.response.code).to.equal(201); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Testovací plavba\",\n  \"location\": \"Korfu\",\n  \"country\": \"Řecko\",\n  \"type\": \"RELAX\",\n  \"startDate\": \"2026-07-01\",\n  \"endDate\": \"2026-07-08\",\n  \"priceCzk\": 17000,\n  \"capacity\": 8,\n  \"booked\": 0,\n  \"skipperIncluded\": true,\n  \"highlights\": [\"Krásné zátoky\", \"4 kajuty\"],\n  \"description\": \"Pohodová plavba po Jónském moři.\"\n}"
            }
          }
        },
        {
          "name": "Vytvoření plavby – neplatné datum (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('endDate před startDate vrátí 400', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errors).to.have.property('endDate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Špatné datum\",\n  \"location\": \"Korfu\",\n  \"type\": \"RELAX\",\n  \"startDate\": \"2026-07-10\",\n  \"endDate\": \"2026-07-01\",\n  \"priceCzk\": 1000,\n  \"capacity\": 4\n}"
            }
          }
        },
        {
          "name": "Detail plavby",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí detail plavby', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.equal(pm.collectionVariables.get('tripId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips/{{tripId}}"
          }
        },
        {
          "name": "Úprava plavby",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Úprava vrátí 200 s novým názvem', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.title).to.equal('Upravená plavba');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/trips/{{tripId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Upravená plavba\",\n  \"location\": \"Korfu\",\n  \"country\": \"Řecko\",\n  \"type\": \"RELAX\",\n  \"startDate\": \"2026-07-01\",\n  \"endDate\": \"2026-07-08\",\n  \"priceCzk\": 18000,\n  \"capacity\": 8,\n  \"booked\": 0,\n  \"skipperIncluded\": true,\n  \"highlights\": [\"Krásné zátoky\"],\n  \"description\": \"Aktualizovaný popis.\"\n}"
            }
          }
        },
        {
          "name": "Detail plavby – nenalezena (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Neexistující plavba vrátí 404', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips/neexistujici-id"
          }
        },
        {
          "name": "Smazání plavby",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Smazání vrátí 204', () => {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/trips/{{tripId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },

    {
      "name": "Rezervace",
      "item": [
        {
          "name": "Vytvoření rezervace",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Před spuštěním je potřeba mít platné tripId.",
                  "// Spusť nejdřív 'Plavby / Vytvoření plavby'."
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('bookingId', body.id);",
                  "    pm.test('Vytvoření rezervace vrátilo 201 a id', () => {",
                  "        pm.expect(body.id).to.be.a('string');",
                  "        pm.expect(body.tripId).to.exist;",
                  "        pm.expect(body.seats).to.equal(2);",
                  "    });",
                  "} else {",
                  "    pm.test('Neočekávaný status: ' + pm.response.code, () => { pm.expect(pm.response.code).to.equal(201); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"seats\": 2,\n  \"contactName\": \"Testovací Jméno\",\n  \"contactEmail\": \"rezervace@test.cz\"\n}"
            }
          }
        },
        {
          "name": "Seznam rezervací přihlášeného uživatele",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí pole rezervací (pouze vlastní)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    body.forEach(b => {",
                  "        pm.expect(b.userId).to.equal(pm.collectionVariables.get('userId'));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Detail rezervace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vrátí detail rezervace', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.equal(pm.collectionVariables.get('bookingId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Úprava rezervace (počet míst)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Úprava vrátí 200 s novým počtem míst', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.seats).to.equal(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"seats\": 3,\n  \"contactName\": \"Testovací Jméno\",\n  \"contactEmail\": \"rezervace@test.cz\"\n}"
            }
          }
        },
        {
          "name": "Detail rezervace – nenalezena (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Neexistující rezervace vrátí 404', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/neexistujici-id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Zrušení rezervace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zrušení vrátí 204', () => {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },

    {
      "name": "Upload",
      "item": [
        {
          "name": "Nahrání obrázku",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload vrátí 200 a url', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.url).to.include('/images/uploads/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Vyber soubor jpg/png/webp (max 10 MB)"
                }
              ]
            }
          }
        },
        {
          "name": "Nahrání obrázku – nepovolený formát (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Nepovolený formát vrátí 400', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error).to.include('Povolené formáty');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Vyber soubor s příponou .gif nebo .pdf"
                }
              ]
            }
          }
        }
      ]
    }

  ]
